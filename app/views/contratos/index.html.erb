<h1 class="mb-4 text-primary fw-bold d-flex align-items-center">
  <i class="bi bi-file-earmark-text-fill me-2"></i> Contratos
</h1>

<!-- Buscador moderno -->
<div class="search-form mb-3">
  <%= form_with(url: contratos_path, method: :get, local: true) do |f| %>
    <div class="search-wrapper">
      <%= f.text_field :search,
                       value: params[:search],
                       placeholder: "Buscar contrato, cliente, evento, número o estado...",
                       class: "input-search",
                       oninput: "autoSearch(this)" %>
      <button type="button" class="clear-btn"
              onclick="this.previousElementSibling.value=''; this.form.submit();">
        ×
      </button>
    </div>
  <% end %>
</div>

<style>
    .search-wrapper {
        position: relative;
        width: 100%;
        max-width: 420px;
    }

    .input-search {
        width: 100%;
        padding: 10px 40px 10px 15px;
        border-radius: 10px;
        border: 2px solid #00a8ff;
        outline: none;
        transition: 0.3s;
    }

    .input-search:focus {
        box-shadow: 0 0 8px rgba(0, 168, 255, 0.4);
    }

    .clear-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        font-size: 20px;
        color: #555;
        cursor: pointer;
    }
    .btn-add-contrato {
        background: linear-gradient(90deg, #00a8ff, #0097e6);
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(0, 168, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        font-size: 15px;
    }

    .btn-add-contrato:hover {
        background: linear-gradient(90deg, #0097e6, #00a8ff);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 168, 255, 0.4);
        text-decoration: none;
        color: white;
    }

</style>

<script>
    let timer;
    function autoSearch(input) {
        clearTimeout(timer);
        timer = setTimeout(() => input.form.submit(), 400);
    }
</script>


<div class="mb-3">
  <%= link_to new_contrato_path, class: "btn-add-contrato" do %>
    <i class="bi bi-file-earmark-plus-fill me-2"></i> Agregar Contrato
  <% end %>
</div>

<style>
    .btn-add-contrato {
        background: linear-gradient(90deg, #00a8ff, #0097e6);
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(0, 168, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        font-size: 15px;
    }

    .btn-add-contrato:hover {
        background: linear-gradient(90deg, #0097e6, #00a8ff);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 168, 255, 0.4);
        text-decoration: none;
        color: white;
    }
    /* Animación suave para iconos */
    .bi {
        transition: transform 0.25s ease, color 0.25s ease;
    }

    .bi:hover {
        transform: scale(1.25) rotate(5deg);
        color: #00a8ff;
    }

    .btn-outline-secondary .bi:hover { color: #0984e3; }
    .btn-outline-primary .bi:hover   { color: #e17055; }
    .btn-outline-danger .bi:hover    { color: #d63031; }

</style>

<table class="table table-hover align-middle shadow-sm">
  <thead class="table-primary">
  <tr>
    <th>ID</th>
    <th>Cliente</th>
    <th>Evento</th>
    <th>Número</th>
    <th>Fecha</th>
    <th>Monto Total</th>
    <th>Estado</th>
    <th>Acciones</th>
  </tr>
  </thead>
  <tbody>
  <% @contratos.each do |contrato| %>
    <tr>
      <td><%= contrato.id %></td>
      <td><%= contrato.cliente.nombre %> <%= contrato.cliente.apellido %></td>
      <td><%= contrato.evento.tipo_evento %></td>
      <td><%= contrato.numero_contrato %></td>
      <td><%= contrato.fecha_contrato.strftime("%d/%m/%Y") %></td>
      <td>₲<%= number_with_delimiter(contrato.monto_total.to_i, delimiter: ".") %></td>
      <td><%= contrato.estado %></td>
      <td class="text-center">
        <div class="btn-group" role="group">

          <%= link_to contrato_path(contrato),
                      class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
            <i class="bi bi-eye"></i> Ver
          <% end %>

          <%= link_to edit_contrato_path(contrato),
                      class: "btn btn-sm btn-outline-primary d-flex align-items-center gap-1" do %>
            <i class="bi bi-pencil-square"></i> Editar
          <% end %>

          <%= button_to contrato_path(contrato),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger d-flex align-items-center gap-1",
                        form: { onsubmit: "return confirm('¿Seguro que querés eliminar este contrato?');" } do %>
            <i class="bi bi-trash"></i> Eliminar
          <% end %>

        </div>
      </td>

    </tr>
  <% end %>
  </tbody>
</table>
<nav class="d-flex justify-content-center mt-4">
  <ul class="pagination">
    <% if @contratos.prev_page %>
      <li class="page-item">
        <%= link_to "Anterior", url_for(page: @contratos.prev_page), class: "page-link" %>
      </li>
    <% end %>

    <% (1..@contratos.total_pages).each do |page| %>
      <% if page == @contratos.current_page %>
        <li class="page-item active"><span class="page-link"><%= page %></span></li>
      <% else %>
        <li class="page-item">
          <%= link_to page, url_for(page: page), class: "page-link" %>
        </li>
      <% end %>
    <% end %>

    <% if @contratos.next_page %>
      <li class="page-item">
        <%= link_to "Siguiente", url_for(page: @contratos.next_page), class: "page-link" %>
      </li>
    <% end %>
  </ul>
</nav>
<style>
    .pagination {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 5px;
    }

    .page-link {
        padding: 6px 12px;
        background-color: #f1f2f6;
        border-radius: 5px;
        color: #273c75;
        text-decoration: none;
        transition: 0.2s;
    }

    .page-link:hover {
        background-color: #00a8ff;
        color: white;
        transform: translateY(-2px);
    }

    .page-item.active .page-link {
        background-color: #273c75;
        color: white;
    }
</style>
