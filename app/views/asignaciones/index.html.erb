<!-- Título con ícono -->
<h1 class="mb-4 text-primary fw-bold d-flex align-items-center">
  <i class="bi bi-clipboard-check-fill me-2"></i> Asignaciones
</h1>

<!-- Buscador moderno -->
<div class="search-form mb-3">
  <%= form_with(url: asignaciones_path, method: :get, local: true) do |f| %>
    <div class="search-wrapper">
      <%= f.text_field :search,
                       value: params[:search],
                       placeholder: "Buscar evento, empleado, rol, tarea o estado...",
                       class: "input-search",
                       oninput: "autoSearch(this)" %>
      <button type="button" class="clear-btn"
              onclick="this.previousElementSibling.value=''; this.form.submit();">
        ×
      </button>
    </div>
  <% end %>
</div>

<!-- Botón agregar asignación -->
<div class="mb-3">
  <%= link_to new_asignacione_path, class: "btn-add-asignaciones " do %>
    <i class="bi bi-plus-circle-fill"></i> Agregar Asignación
  <% end %>
</div>

<!-- Tabla de asignaciones -->
<table class="table table-hover align-middle shadow-sm">
  <thead class="table-primary">
  <tr>
    <th>Evento</th>
    <th>Empleado</th>
    <th>Rol</th>
    <th>Tarea</th>
    <th>Estado</th>
    <th class="text-center">Acciones</th>
  </tr>
  </thead>
  <tbody>
  <% @asignaciones.each do |a| %>
    <tr>
      <td><%= a.evento.nombre_evento %></td>
      <td><%= a.empleado.nombre %></td>
      <td><%= a.rol %></td>
      <td><%= a.tarea %></td>
      <td><%= a.estado %></td>
      <td class="text-center">
        <div class="btn-group" role="group">
          <%= link_to asignacione_path(a),
                      class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
            <i class="bi bi-eye"></i> Ver
          <% end %>

          <%= link_to edit_asignacione_path(a),
                      class: "btn btn-sm btn-outline-primary d-flex align-items-center gap-1" do %>
            <i class="bi bi-pencil-square"></i> Editar
          <% end %>

          <%= button_to asignacione_path(a),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger d-flex align-items-center gap-1",
                        form: { onsubmit: "return confirm('¿Seguro que querés eliminar esta asignación?');" } do %>
            <i class="bi bi-trash"></i> Eliminar
          <% end %>
        </div>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>

<!-- Paginación -->
<nav class="d-flex justify-content-center mt-4">
  <ul class="pagination">
    <% if @asignaciones.prev_page %>
      <li class="page-item">
        <%= link_to "Anterior", url_for(page: @asignaciones.prev_page), class: "page-link" %>
      </li>
    <% end %>

    <% (1..@asignaciones.total_pages).each do |page| %>
      <% if page == @asignaciones.current_page %>
        <li class="page-item active"><span class="page-link"><%= page %></span></li>
      <% else %>
        <li class="page-item"><%= link_to page, url_for(page: page), class: "page-link" %></li>
      <% end %>
    <% end %>

    <% if @asignaciones.next_page %>
      <li class="page-item">
        <%= link_to "Siguiente", url_for(page: @asignaciones.next_page), class: "page-link" %>
      </li>
    <% end %>
  </ul>
</nav>

<!-- Scripts -->
<script>
    let timer;
    function autoSearch(input) {
        clearTimeout(timer);
        timer = setTimeout(() => input.form.submit(), 400);
    }
</script>

<!-- Estilos -->
<style>
    /* Buscador */
    .search-wrapper {
        position: relative;
        width: 100%;
        max-width: 420px;
    }

    .input-search {
        width: 100%;
        padding: 10px 40px 10px 15px;
        border-radius: 10px;
        border: 2px solid #00a8ff;
        outline: none;
        transition: 0.3s;
    }

    .input-search:focus {
        box-shadow: 0 0 8px rgba(0, 168, 255, 0.4);
    }

    .clear-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        font-size: 20px;
        color: #555;
        cursor: pointer;
    }

    /* Botón agregar */
    .btn-add-asignaciones {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        color: #fff;
        padding: 10px 18px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(90deg, #00a8ff, #0097e6);
        box-shadow: 0 4px 12px rgba(0, 168, 255, 0.3);
        transition: all 0.3s ease;
    }

    .btn-add-asignaciones:hover {
        background: linear-gradient(90deg, #0097e6, #00a8ff);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 168, 255, 0.4);
        color: #fff;
        text-decoration: none;
    }

    /* Paginación */
    .pagination {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 5px;
    }

    .page-item .page-link {
        display: block;
        padding: 6px 12px;
        background-color: #f1f2f6;
        border-radius: 5px;
        color: #273c75;
        text-decoration: none;
        transition: all 0.2s;
    }

    .page-item .page-link:hover {
        background-color: #00a8ff;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    .page-item.active .page-link {
        background-color: #273c75;
        color: white;
    }

    .page-item.disabled .page-link {
        cursor: default;
        background-color: #e0e0e0;
        color: #888;
    }

    /* Animación iconos */
    .bi {
        transition: transform 0.25s ease, color 0.25s ease;
    }

    .bi:hover {
        transform: scale(1.25) rotate(5deg);
        color: #00a8ff;
    }

    .btn-outline-secondary .bi:hover { color: #0984e3; }
    .btn-outline-primary .bi:hover   { color: #e17055; }
    .btn-outline-danger .bi:hover    { color: #d63031; }
</style>
