<h1>Reporte de Servicios</h1>

<table class="table table-striped table-hover">
  <thead class="table-dark">
  <tr>
    <th>ID</th>
    <th>Nombre</th>
    <th>Categoría</th>
    <th>Descripción</th>
    <th>Costo Base</th>
    <th>Activo</th>
  </tr>
  </thead>
  <tbody>
  <% @servicios.each do |s| %>
    <tr>
      <td><%= s.id %></td>
      <td><%= s.nombre %></td>
      <td><%= s.categoria %></td>
      <td><%= s.descripcion %></td>
      <td><%= number_to_currency(s.costo_base, unit: "₲") %></td>
      <td><%= s.activo ? "Sí" : "No" %></td>
    </tr>
  <% end %>
  </tbody>
</table>
