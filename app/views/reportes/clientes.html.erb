<h1>Reporte de Clientes</h1>

<table class="table table-striped">
  <thead>
  <tr>
    <th>ID</th>
    <th>Nombre</th>
    <th>Apellido</th>
    <th>Tipo de Evento</th>
    <th>Teléfono</th>
  </tr>
  </thead>
  <tbody>
  <% @clientes.each do |cliente| %>
    <tr>
      <td><%= cliente.id %></td>
      <td><%= cliente.nombre %></td>
      <td><%= cliente.apellido %></td>
      <td><%= cliente.tipo %></td>
      <td><%= cliente.telefono %></td>
    </tr>
  <% end %>
  </tbody>
</table>
