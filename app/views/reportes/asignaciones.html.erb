<h1>Reporte de Asignaciones</h1>

<table class="table table-striped table-hover">
  <thead class="table-dark">
  <tr>
    <th>ID</th>
    <th>Nombre Asignación</th>
    <th>Evento</th>
    <th>Empleado</th>
    <th>Rol</th>
    <th>Tarea</th>
    <th>Estado</th>
  </tr>
  </thead>
  <tbody>
  <% @asignaciones.each do |a| %>
    <tr>
      <td><%= a.id %></td>
      <td><%= a.nombre %></td>
      <td><%= a.evento.nombre_evento %></td>
      <td><%= a.empleado.nombre %></td>
      <td><%= a.rol %></td>
      <td><%= a.tarea %></td>
      <td><%= a.estado %></td>
    </tr>
  <% end %>
  </tbody>
</table>
