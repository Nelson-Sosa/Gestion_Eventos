<!DOCTYPE html>
<html>
<head>
  <title>Sistema de Gestión de Eventos</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  <%= javascript_importmap_tags %>

  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
                          integrity: "sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH",
                          crossorigin: "anonymous" %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <style>
      /* ===== RESET Y BASE ===== */
      * {
          box-sizing: border-box;
      }

      body {
          margin: 0;
          font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
          display: flex;
          background-color: #f3f5f7;
          color: #2f3640;
          transition: background-color 0.3s ease;
      }

      a {
          text-decoration: none;
          color: inherit;
      }

      /* ===== SIDEBAR ===== */
      .sidebar {
          width: 250px;
          height: 100vh;
          background: linear-gradient(180deg, #1e272e 0%, #2f3640 100%);
          color: #f1f2f6;
          display: flex;
          flex-direction: column;
          padding: 25px 20px;
          position: fixed;
          box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
      }

      .sidebar h2 {
          font-size: 22px;
          text-align: center;
          font-weight: 600;
          letter-spacing: 1px;
          margin-bottom: 35px;
          color: #00a8ff;
      }

      .sidebar a {
          padding: 12px 15px;
          border-radius: 8px;
          margin-bottom: 8px;
          display: flex;
          align-items: center;
          font-size: 15px;
          gap: 12px;
          transition: all 0.2s ease-in-out;
      }

      .sidebar a:hover {
          background-color: #00a8ff;
          color: white;
          transform: translateX(4px);
      }

      /* ===== MAIN CONTENT ===== */
      .main-content {
          margin-left: 270px;
          padding: 35px;
          width: calc(100% - 270px);
          min-height: 100vh;
          background-color: #f9fafb;
          background-image: radial-gradient(circle at top left, #f0f3f5, #ffffff);
      }

      .notifications {
          background-color: #e3f2fd;
          border-left: 6px solid #00a8ff;
          padding: 14px 18px;
          border-radius: 8px;
          margin-bottom: 25px;
          font-weight: 500;
          color: #333;
          display: flex;
          align-items: center;
          gap: 10px;
      }

      .notifications::before {
          content: "💡";
          font-size: 18px;
      }

      /* ===== CARDS ===== */
      .dashboard {
          display: flex;
          flex-wrap: wrap;
          gap: 20px;
      }

      .card {
          background-color: white;
          flex: 1 1 240px;
          padding: 20px;
          border-radius: 10px;
          box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
          transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .card:hover {
          transform: translateY(-3px);
          box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      }

      .card h3 {
          margin-top: 0;
          font-weight: 600;
          color: #2f3640;
      }

      .btn-primary {
          background-color: #00a8ff;
          border-color: #00a8ff;
      }

      .btn-primary:hover {
          background-color: #0097e6;
      }

      .btn-secondary {
          background-color: #718093;
          border-color: #718093;
      }

      .btn-secondary:hover {
          background-color: #636e72;
      }
  </style>
</head>

<body>
<!-- Sidebar -->
<div class="sidebar">
  <h2>EventosApp</h2>
  <%= link_to "🏠 Dashboard", root_path %>
  <%= link_to "👤 Clientes", clientes_path %>
  <%= link_to "🎉 Eventos", eventos_path %>
  <%= link_to "📄 Contratos", contratos_path %>
  <%= link_to "🛎️ Servicios", servicios_path %>
  <%= link_to "👥 Personal", empleados_path %>
  <%= link_to "📝 Asignaciones", asignaciones_path %>
  <%= link_to "📊 Reportes", reportes_path %>
</div>

<!-- Main Content -->
<div class="main-content">
  <div class="notifications">
    Administra clientes, eventos, contratos y personal de manera eficiente.
  </div>

  <%= yield %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>
</html>
