<%= form_with(model: @cliente, local: true) do |form| %>
  <% if @cliente.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@cliente.errors.count, "error") %> impidieron guardar este cliente:</h4>
      <ul>
        <% @cliente.errors.full_messages.each do |mensaje| %>
          <li><%= mensaje %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group mb-3">
    <%= form.label :nombre, "Nombre", class: "form-label fw-bold" %>
    <%= form.text_field :nombre, class: "form-control shadow-sm" %>
  </div>

  <div class="form-group mb-3">
    <%= form.label :apellido, "Apellido", class: "form-label fw-bold" %>
    <%= form.text_field :apellido, class: "form-control shadow-sm" %>
  </div>

  <div class="form-group mb-3">
    <%= form.label :tipo, "Tipo de evento", class: "form-label fw-bold" %>
    <%= form.select :tipo,
                    options_for_select([
                                         ["Boda", "Boda"],
                                         ["Cumpleaños", "Cumpleaños"],
                                         ["Evento Corporativo", "Evento Corporativo"],
                                         ["Graduación", "Graduación"],
                                         ["Fiesta Infantil", "Fiesta Infantil"],
                                         ["Concierto", "Concierto"],
                                         ["Otro", "Otro"]
                                       ], @cliente.tipo),
                    { prompt: "Seleccionar tipo de evento" },
                    class: "form-select shadow-sm" %>
  </div>

  <div class="form-group mb-3">
    <%= form.label :telefono, "Teléfono", class: "form-label fw-bold" %>
    <%= form.telephone_field :telefono, class: "form-control shadow-sm" %>
  </div>

  <div class="mt-3 d-flex gap-2">
    <%= form.submit "Guardar", class: "btn btn-primary px-4" %>
    <%= link_to "Volver", clientes_path, class: "btn btn-secondary px-4" %>
  </div>
<% end %>
