<%= form_with(model: @evento, local: true) do |form| %>
  <% if @evento.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@evento.errors.count, "error") %> impidieron guardar este evento:</h4>
      <ul>
        <% @evento.errors.full_messages.each do |mensaje| %>
          <li><%= mensaje %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :cliente_id, "Cliente", class: "form-label fw-bold" %>
    <%= form.collection_select :cliente_id, Cliente.all, :id, :nombre, { prompt: "Seleccionar Cliente" }, class: "form-select shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :nombre_evento, "Nombre del Evento", class: "form-label fw-bold" %>
    <%= form.text_field :nombre_evento, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :tipo_evento, "Tipo de Evento", class: "form-label fw-bold" %>
    <%= form.select :tipo_evento, options_for_select(["Boda","Cumpleaños","Evento Corporativo","Graduación","Fiesta Infantil","Concierto","Otro"], @evento.tipo_evento),
                    { prompt: "Seleccionar tipo de evento" },
                    class: "form-select shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :fecha_inicio, "Fecha de Inicio", class: "form-label fw-bold" %>
    <%= form.datetime_select :fecha_inicio, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :fecha_fin, "Fecha de Fin", class: "form-label fw-bold" %>
    <%= form.datetime_select :fecha_fin, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :lugar, "Lugar", class: "form-label fw-bold" %>
    <%= form.text_field :lugar, class: "form-control shadow-sm" %>
  </div>

  <div class="mb-3">
    <%= form.label :estado, "Estado", class: "form-label fw-bold" %>
    <%= form.select :estado, options_for_select(["Planificado","En Progreso","Finalizado","Cancelado"], @evento.estado),
                    { prompt: "Seleccionar estado" },
                    class: "form-select shadow-sm" %>
  </div>


  <div class="mb-3">
    <%= form.label :recursos_necesarios, "Recursos necesarios", class: "form-label fw-bold" %>
    <%= form.text_area :recursos_necesarios, rows: 4, class: "form-control shadow-sm", placeholder: "Ej: Sillas, Mesas, Sonido, Personal de catering..." %>
  </div>

  <div class="mt-3 d-flex gap-2">
    <%= form.submit "Guardar", class: "btn btn-primary px-4" %>
    <%= link_to "Volver", eventos_path, class: "btn btn-secondary px-4" %>
  </div>
<% end %>
