<h1 class="mb-4 text-primary fw-bold d-flex align-items-center">
  <i class="bi bi-calendar-event-fill me-2"></i> Eventos
</h1>

<!-- Buscador moderno -->
<div class="search-form mb-3">
  <%= form_with(url: eventos_path, method: :get, local: true) do |f| %>
    <div class="search-wrapper">

      <%= f.text_field :search,
                       value: params[:search],
                       placeholder: "Buscar evento, tipo, cliente, lugar o estado...",
                       class: "input-search",
                       oninput: "this.form.submit()" %>

      <button type="button" class="clear-btn"
              onclick="this.previousElementSibling.value=''; this.form.submit();">
        ×
      </button>

    </div>
  <% end %>
</div>

<style>
    .search-wrapper {
        position: relative;
        width: 100%;
        max-width: 420px;
    }

    .input-search {
        width: 100%;
        padding: 10px 40px 10px 15px;
        border-radius: 10px;
        border: 2px solid #00a8ff;
        outline: none;
        transition: 0.3s;
    }

    .input-search:focus {
        box-shadow: 0 0 8px rgba(0, 168, 255, 0.4);
    }

    .clear-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        font-size: 20px;
        color: #555;
        cursor: pointer;
    }

</style>


<div class="mb-3">
  <%= link_to new_evento_path, class: "btn-add-evento" do %>
    <i class="bi bi-calendar-plus-fill me-2"></i> Agregar evento
  <% end %>
</div>

<style>
    /* Animación suave para todos los íconos */
    .bi {
        transition: transform 0.25s ease, color 0.25s ease;
    }

    /* Hover general */
    .bi:hover {
        transform: scale(1.25) rotate(5deg);
        color: #00a8ff;
    }

    /* Hover por tipo de acción */
    .btn-outline-secondary .bi:hover { color: #0984e3; }
    .btn-outline-primary .bi:hover   { color: #e17055; }
    .btn-outline-danger .bi:hover    { color: #d63031; }
    .btn-add-evento {
        background: linear-gradient(90deg, #00a8ff, #0097e6);
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(0, 168, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        font-size: 15px;
    }

    .btn-add-evento:hover {
        background: linear-gradient(90deg, #0097e6, #00a8ff);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 168, 255, 0.4);
        text-decoration: none;
        color: white;
    }

</style>

<table class="table table-hover align-middle shadow-sm">
  <thead class="table-primary">
  <tr>
    <th>ID</th>
    <th>Nombre</th>
    <th>Tipo</th>
    <th>Cliente</th>
    <th>Fecha Inicio</th>
    <th>Fecha Fin</th>
    <th>Lugar</th>
    <th>Estado</th>
    <th>Recursos</th>
    <th>Acciones</th>
  </tr>
  </thead>
  <tbody>
  <% @eventos.each do |evento| %>
    <tr>
      <td><%= evento.id %></td>
      <td><%= evento.nombre_evento %></td>
      <td><%= evento.tipo_evento %></td>
      <td><%= evento.cliente.nombre %> <%= evento.cliente.apellido %></td>
      <td><%= evento.fecha_inicio.strftime("%d/%m/%Y %H:%M") %></td>
      <td><%= evento.fecha_fin.strftime("%d/%m/%Y %H:%M") %></td>
      <td><%= evento.lugar %></td>
      <td><%= evento.estado %></td>

      <td>
        <% if evento.recursos_necesarios.present? %>
          <% evento.recursos_necesarios.split(",").each do |recurso| %>
            <span class="badge bg-info text-dark me-1"><%= recurso.strip %></span>
          <% end %>
        <% end %>
      </td>

      <td class="text-center">
        <div class="btn-group" role="group">

          <%= link_to evento_path(evento),
                      class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
            <i class="bi bi-eye"></i> Ver
          <% end %>

          <%= link_to edit_evento_path(evento),
                      class: "btn btn-sm btn-outline-primary d-flex align-items-center gap-1" do %>
            <i class="bi bi-pencil-square"></i> Editar
          <% end %>

          <%= button_to evento_path(evento),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger d-flex align-items-center gap-1",
                        form: { onsubmit: "return confirm('¿Seguro que querés eliminar este evento?');" } do %>
            <i class="bi bi-trash"></i> Eliminar
          <% end %>

        </div>
      </td>

    </tr>
  <% end %>
  </tbody>
</table>
<!-- Paginación personalizada -->
<nav class="d-flex justify-content-center mt-4">
  <ul class="pagination">
    <% if @eventos.prev_page %>
      <li class="page-item">
        <%= link_to "Anterior", url_for(page: @eventos.prev_page), class: "page-link" %>
      </li>
    <% end %>

    <% (1..@eventos.total_pages).each do |page| %>
      <% if page == @eventos.current_page %>
        <li class="page-item active"><span class="page-link"><%= page %></span></li>
      <% else %>
        <li class="page-item"><%= link_to page, url_for(page: page), class: "page-link" %></li>
      <% end %>
    <% end %>

    <% if @eventos.next_page %>
      <li class="page-item">
        <%= link_to "Siguiente", url_for(page: @eventos.next_page), class: "page-link" %>
      </li>
    <% end %>
  </ul>
</nav>
